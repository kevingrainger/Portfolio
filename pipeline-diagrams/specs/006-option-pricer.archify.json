 "cards": [
  {
   "dot": "emerald",
   "title": "One change to Black-Scholes",
   "items": [
    "Volatility becomes a function of time, read from the option chain as forward volatility",
    "European prices then depend only on the integrated variance, so an exact formula remains and the solver can be tested against it",
    "The implied interest rate recovered from put-call parity is checked against January 2023 rates"
   ]
  },
  {
   "dot": "violet",
   "title": "Three option types",
   "items": [
    "European: validation of the solver, including measured convergence order",
    "American: free boundary by projected SOR, checked against a binomial tree",
    "Asian: reduction to one dimension by a change of numeraire, checked by Monte Carlo with a geometric control variate"
   ]
  },
  {
   "dot": "slate",
   "title": "Credit and status",
   "items": [
    "Asian method: Vecer (2001), after Rogers and Shi (1995). Control variate: Kemna and Vorst (1990)",
    "Projected SOR as in Wilmott, Howison and Dewynne (1995)",
    "Built so far: SPX extraction, European and American pricing. Asian pricing and SET50 calibration are in progress"
   ]
  }
 ]
