 "cards": [
  {
   "dot": "emerald",
   "title": "Replication, then one extension",
   "items": [
    "Replicates Guerzoni, Riso and Zoia (2026): extreme weather as the main driver of Italian electricity price volatility",
    "Extension: observed weather is replaced by SEAS5 seasonal forecasts made in advance, so the model can be used before the season happens"
   ]
  },
  {
   "dot": "violet",
   "title": "Model",
   "items": [
    "GARCH-MIDAS (Engle, Ghysels and Sohn 2013): daily variance = slow level tau x fast GARCH component g",
    "tau is a beta-weighted average of past monthly weather extremes, set by two parameters",
    "A regime-switching layer is tested on the numbers and kept only if it improves the forecast"
   ]
  },
  {
   "dot": "slate",
   "title": "The result is a horizon",
   "items": [
    "Three models are scored on the same out-of-sample window",
    "Expected outcome: forecast weather loses to observed weather and beats no weather",
    "The number reported is the forecast lead, in months, at which that advantage disappears"
   ]
  }
 ]
