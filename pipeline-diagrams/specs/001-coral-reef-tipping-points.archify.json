 "cards": [
  {
   "dot": "emerald",
   "title": "Question",
   "items": [
    "Mumby, Hastings and Edwards (2007) found an irreversible grazing threshold in a model where every reef patch interacts with every other",
    "A Potts lattice is the same state structure with interactions restricted to neighbours",
    "The interaction range z is the experimental variable: how much hysteresis survives at short range, and does space give earlier warning"
   ]
  },
  {
   "dot": "violet",
   "title": "Controls",
   "items": [
    "Coupling is divided by z, so range varies while total coupling is held fixed",
    "z = 0 (independent sites) must show no hysteresis",
    "All free-running results have the data-assimilation nudge switched off"
   ]
  },
  {
   "dot": "slate",
   "title": "Methods and credit",
   "items": [
    "Survey data: Gilmour, Cook and Ryan (2021)",
    "Transition order from bimodality, the Binder cumulant and finite-size scaling",
    "Patch-size exponents by maximum likelihood (Clauset, Shalizi and Newman 2009); rate-induced tipping after Ashwin et al. (2012)"
   ]
  }
 ]
